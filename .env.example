# Copy to .env and fill in. NEVER commit .env: it holds your Steam password.

# --- Demo (no Steam account needed) ---
# DEMO=1 runs a pretend account: nothing real is opened. Leaving STEAM_ACCOUNT_NAME empty does the same.
DEMO=

# --- Your Steam account (the one holding the cases and keys) ---
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# Optional: the mobile authenticator's shared_secret (base64). With it, the Steam Guard code is made for you.
# Without it, run the container once with -it and type the code Steam sends; a login token is then saved in /data.
STEAM_SHARED_SECRET=

# --- The web page ---
# Required unless DEMO=1: the page can spend your keys. Sign in with UI_USER / UI_PASSWORD.
UI_USER=admin
UI_PASSWORD=
PORT=8080
# Cases opened per press, 1-10 (the screen shows ten at most).
MAX_PER_OPEN=10

# --- Prices (optional) ---
# on: Steam Community Market public price overview (no key needed). off: no prices.
PRICES=on
# USD, GBP, EUR, CAD, AUD, ... (Steam's market currencies)
CURRENCY=USD
PRICE_TTL_HOURS=6
