{
  "name": "tf2-unboxer",
  "version": "1.0.0",
  "description": "Open Team Fortress 2 cases from a Steam account you own, watch ten unbox at once, and see what you made or lost.",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "demo": "DEMO=1 node src/server.js",
    "test": "node --test test/*.test.js",
    "gen-data": "node scripts/gen-unbox-data.js"
  },
  "dependencies": {
    "steam-totp": "2.1.2",
    "steam-user": "5.3.0",
    "tf2": "4.0.0"
  }
}
